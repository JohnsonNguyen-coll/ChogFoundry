MONAD_RPC_URL=https://rpc.monad.xyz
PORT=3001
# Production server defaults to loopback; set 0.0.0.0 only for your host/container.
HOST=127.0.0.1

APP_ORIGIN=http://127.0.0.1:5173
# Supabase PostgreSQL is the primary database. Sessions still expire on restart.

# Optional, verified deployment only. Leave empty until Foundry is actually deployed.
# No fork addresses or guessed factory addresses. This enables read-only market data.
FOUNDRY_FACTORY_ADDRESS=

# Exact factory first-code block. Required with factory address for persistent indexing/SSE.
FOUNDRY_DEPLOYMENT_BLOCK=

# Backend only: copy an actual connection string from Supabase > Connect.
# Prefer direct connection or Session pooler for this persistent Node backend.
# Do not place this in frontend env, chat, source files or logs.
SUPABASE_DATABASE_URL=
# Optional project CA certificate path; TLS certificate verification remains enabled.
SUPABASE_DB_CA_PATH=

# Optional verified Foundry quoter deployment. Never use an isolated fork address here.
FOUNDRY_V4_QUOTER_ADDRESS=

# Enable human-confirmed browser wallet transactions only after the actual Mainnet
# deployment/economics have been reviewed and Supabase/indexer are operational.
# Backend never signs or broadcasts. Missing deployment/storage keeps the UI blocked.
FOUNDRY_WALLET_EXECUTION=false

# Public deployer address. User chose this same wallet as the platform treasury.
# This is an address, NOT a private key; deployment signing stays in your wallet.
FOUNDRY_DEPLOYER_ADDRESS=
