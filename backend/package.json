{
  "name": "@chog-foundry/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/validation.test.mjs tests/profiles.test.mjs tests/postgres.test.mjs tests/frontend-host.test.mjs",
    "test:live": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/live.test.mjs tests/auth-live.test.mjs tests/markets-live.test.mjs",
    "check:chain": "node --env-file-if-exists=.env scripts/check-chain.mjs",
    "check:markets": "node --env-file-if-exists=.env scripts/check-markets.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
