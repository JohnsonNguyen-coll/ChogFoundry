# Railway service Variables. Root Directory: repository root.
# APP_ORIGIN must equal your final Vercel/custom frontend HTTPS origin.
APP_ORIGIN=https://your-frontend.vercel.app
HOST=0.0.0.0
SERVE_FRONTEND=false
NODE_ENV=production

# Supabase > Connect: use a Session pooler for this persistent Node service.
SUPABASE_DATABASE_URL=
SUPABASE_DB_CA_PATH=/app/backend/certs/prod-ca-2021.crt

FOUNDRY_COLLECTION=chog-genesis
FOUNDRY_FACTORY_ADDRESS=0x55D9327B029CA834787a2e1a10AC09A56B6ba811
FOUNDRY_DEPLOYMENT_BLOCK=115864690
FOUNDRY_V4_QUOTER_ADDRESS=0xCc4c32138864b3C5432F30a4a2a2509dCAAf7b25
FOUNDRY_DEPLOYER_ADDRESS=0xadD67137b37E5A61B0566410a8551374dD6a620d
FOUNDRY_WALLET_EXECUTION=true
FOUNDRY_RAFFLE_ADDRESS=0xad49e3d083c502d17De6aDd00Fc12A4FFd1ccA18
FOUNDRY_CAMPAIGNS_ENABLED=true

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
X_CLIENT_ID=
X_BEARER_TOKEN=
X_CLIENT_SECRET=

# Optional backend-only private RPC fallback; public RPCs are attempted first.
ALCHEMY_RPC_URL=
ALCHEMY_WS_URL=

# Do not set PRIVATE_KEY here. API requests never sign or broadcast.
