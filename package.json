{
  "name": "chog-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node backend/scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace @chog-foundry/backend",
    "dev:frontend": "npm run dev --workspace @chog-foundry/frontend",
    "build": "npm run compile --workspace @chog-foundry/contracts && npm run build --workspace @chog-foundry/frontend",
    "compile": "npm run compile --workspace @chog-foundry/contracts",
    "test": "npm run test --workspace @chog-foundry/backend",
    "test:live": "npm run test:live --workspace @chog-foundry/backend",
    "check:chain": "npm run check:chain --workspace @chog-foundry/backend",
    "check:markets": "npm run check:markets --workspace @chog-foundry/backend",
    "test:fork": "npm run test:fork --workspace @chog-foundry/contracts",
    "db:migrate": "npm run db:migrate --workspace @chog-foundry/backend",
    "db:check": "npm run db:check --workspace @chog-foundry/backend",
    "db:import-sqlite": "node --env-file-if-exists=backend/.env backend/scripts/import-sqlite.mjs"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
