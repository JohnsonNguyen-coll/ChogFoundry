FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY contracts/package.json ./contracts/package.json
RUN npm ci --omit=dev --workspace=@chog-foundry/backend --include-workspace-root=false

COPY --chown=node:node backend ./backend
ENV NODE_ENV=production HOST=0.0.0.0 SERVE_FRONTEND=false
ENV SUPABASE_DB_CA_PATH=/app/backend/certs/prod-ca-2021.crt
USER node
CMD ["node", "backend/scripts/start.mjs"]
